# ---- API ----
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
# Run DB migrations automatically on API startup (true in dev, false in prod)
AUTO_MIGRATE=true
# Comma separated list of allowed CORS origins (admin frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Per-request timeout and graceful shutdown timeout
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
# Max request body in bytes (every route)
MAX_BODY_BYTES=1048576
# Per-client-IP budgets per minute: all /api/v1 routes, and register/login only. 0 disables (not in production)
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=minigame
DB_PASSWORD=minigame_dev_password
DB_NAME=minigame
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=1h
# Bootstrap admin account, created on start-up if it does not exist (both or neither)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_dev_password

# ---- Docker Compose only ----
MYSQL_ROOT_PASSWORD=root_dev_password

# ---- Host port mapping (change if 8080 / 3306 are already in use on your machine) ----
API_HOST_PORT=8080
MYSQL_HOST_PORT=3306
ADMIN_HOST_PORT=5173
